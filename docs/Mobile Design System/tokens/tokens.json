        "primary": "#2CB5B5",
        "primaryHover": "#46C7C7",
        "primaryMuted": "#12312F",
        "primaryOn": "#04211F",
        "secondary": "#97A6CC",
        "accent": "#F0965A",
        "workflow": "#4C9AFF"
