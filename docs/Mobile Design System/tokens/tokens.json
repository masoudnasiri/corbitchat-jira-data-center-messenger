  "focus": {
    "ring": { "value": "0 0 0 2px var(--cc-color-bg-elevated), 0 0 0 4px var(--cc-color-primary)", "description": "Keyboard focus ring, applied via :focus-visible" },
    "ringInset": { "value": "inset 0 0 0 2px var(--cc-color-primary)" }
  },
  "typography": {
    "fontFamily": {
      "fa": "'Vazirmatn', 'Tahoma', sans-serif",
      "en": "'Inter', 'Segoe UI', system-ui, sans-serif",
      "mono": "'JetBrains Mono', 'Consolas', monospace"
    },
    "fontSize": {
      "xs": { "value": "11px", "lineHeight": "16px" },
      "sm": { "value": "13px", "lineHeight": "18px" },
      "base": { "value": "15px", "lineHeight": "22px" },
      "md": { "value": "17px", "lineHeight": "24px" },
      "lg": { "value": "20px", "lineHeight": "28px" },
      "xl": { "value": "24px", "lineHeight": "32px" },
      "2xl": { "value": "28px", "lineHeight": "36px" }
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "letterSpacing": {
      "tight": "-0.01em",
      "normal": "0",
      "wide": "0.02em"
    }
  },
  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "touchMin": "44px",
    "screenPaddingX": "16px",
    "screenPaddingY": "16px",
    "cardPadding": "16px",
    "listItemPaddingY": "12px",
    "bottomNavHeight": "56px",
    "topBarHeight": "56px",
    "tabBarHeight": "48px"
  },
  "radius": {
    "none": "0",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "full": "9999px",
    "bubble": "16px",
    "bubbleTail": "4px"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 3px rgba(15, 23, 42, 0.08), 0 1px 2px rgba(15, 23, 42, 0.04)",
    "2": "0 4px 12px rgba(15, 23, 42, 0.10), 0 2px 4px rgba(15, 23, 42, 0.06)",
    "3": "0 8px 24px rgba(15, 23, 42, 0.12), 0 4px 8px rgba(15, 23, 42, 0.08)",
    "fab": "0 6px 16px rgba(13, 110, 110, 0.32)"
  },
  "motion": {
    "duration": {
      "instant": "100ms",
      "fast": "150ms",
      "normal": "250ms",
      "slow": "400ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },
  "breakpoint": {
    "sm": "360px",
    "md": "414px",
    "lg": "768px",
    "xl": "1024px"
  },
  "icon": {
    "size": {
      "sm": "16px",
      "md": "20px",
      "lg": "24px",
      "xl": "32px"
    }
  },
  "zIndex": {
    "base": 0,
    "sticky": 10,
    "dropdown": 100,
    "overlay": 200,
    "modal": 300,
    "toast": 400
  }
