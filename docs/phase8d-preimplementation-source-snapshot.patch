-            return fallback;
-        }
-        String[] parts = v.split(":");
-        int h = Integer.parseInt(parts[0]);
-        int m = Integer.parseInt(parts[1]);
-        if (h < 0 || h > 23 || m < 0 || m > 59) {
-            return fallback;
-        }
-        return h * 60 + m;
